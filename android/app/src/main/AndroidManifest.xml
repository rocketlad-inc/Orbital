<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The only permission the app needs. Notifications are delivered
         by Chrome to the web push subscription; POST_NOTIFICATIONS is
         what lets them appear on Android 13 and later. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The widget fetches its card from a FOREGROUND service, because a
         background receiver is denied the network by Data Saver and the
         per-app background-data switch (the phone said UnknownHost).
         The service is of type shortService, which needs no type
         permission and no Play Console declaration. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Lets the widget report WHY a fetch failed (Data Saver state, the
         active network) in its own text. Normal permission, no prompt. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:allowBackup="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.Orbital">

        <!-- The whole app. LauncherActivity opens orbital-empire.com as a
             trusted tab: no address bar, no browser chrome, and the site
             is verified by the assetlinks.json we serve. -->
        <activity
            android:name="com.google.androidbrowserhelper.trusted.LauncherActivity"
            android:exported="true"
            android:theme="@style/Theme.Orbital.Splash"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode">

            <meta-data
                android:name="android.support.customtabs.trusted.DEFAULT_URL"
                android:value="@string/launch_url" />

            <!-- Brand the splash and the system bars so the launch does
                 not flash white before a very dark game. -->
            <meta-data
                android:name="android.support.customtabs.trusted.STATUS_BAR_COLOR"
                android:resource="@color/orbitalBackground" />
            <meta-data
                android:name="android.support.customtabs.trusted.NAVIGATION_BAR_COLOR"
                android:resource="@color/orbitalBackground" />
            <meta-data
                android:name="android.support.customtabs.trusted.SPLASH_IMAGE_DRAWABLE"
                android:resource="@mipmap/ic_launcher" />
            <meta-data
                android:name="android.support.customtabs.trusted.SPLASH_SCREEN_BACKGROUND_COLOR"
                android:resource="@color/orbitalBackground" />
            <meta-data
                android:name="android.support.customtabs.trusted.FILE_PROVIDER_AUTHORITY"
                android:value="com.orbitalempire.game.fileprovider" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Links to orbital-empire.com open IN the app rather than
                 bouncing to the browser. autoVerify makes Android check
                 assetlinks.json at install time. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="orbital-empire.com" />
            </intent-filter>
        </activity>


        <!-- ==== HOME SCREEN WIDGET =============================== -->
        <!--
          exported=false is correct and deliberate: the system delivers
          APPWIDGET_UPDATE to the component directly, so the receiver
          does not need to be open to other apps. Exporting it would let
          any app on the device poke it.
        -->
        <receiver
            android:name=".OrbitalWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/orbital_widget_info" />
        </receiver>

        <!--
          The second card. A separate provider and not a mode of the
          first, because the widget picker lists providers: this is how
          a player gets to choose it, and how both can sit on one home
          screen at once. It shares the pairing and the token with
          .OrbitalWidget, so it needs no setup of its own.
        -->
        <receiver
            android:name=".OrbitalBattleWidget"
            android:exported="false"
            android:label="@string/battle_widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/orbital_battle_widget_info" />
        </receiver>

        <!--
          Receives orbital://widget?token=... from the game's settings
          panel. A PRIVATE SCHEME, not the https host: that host is
          already claimed by the TWA launcher for every path, and two
          components racing for one URL is how a player ends up with the
          game reopened instead of a connected widget.

          exported=true because the sender is Chrome, a different app.
        -->
        <activity
            android:name=".WidgetLinkActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="orbital" android:host="widget" />
            </intent-filter>
        </activity>

        <!-- Tapping the widget goes through here; see the class. -->
        <activity
            android:name=".LauncherRelayActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- Pairs and fetches the widget card with the network access of
             a foreground process. shortService: at most three minutes,
             no type permission. exported=false: only we start it. -->
        <service
            android:name=".WidgetFetchService"
            android:exported="false"
            android:foregroundServiceType="shortService" />

        <!-- Delegates web push notifications to the site's service worker. -->
        <service
            android:name="com.google.androidbrowserhelper.trusted.DelegationService"
            android:exported="true">
            <!-- The status-bar icon Chrome asks this service for when it
                 posts the site's notifications under this app. Google's
                 own TWA template (Bubblewrap) always declares it; without
                 it the service answers "no icon" and Chrome has nothing to
                 post the notification with. -->
            <meta-data
                android:name="android.support.customtabs.trusted.SMALL_ICON"
                android:resource="@drawable/ic_notification" />
            <intent-filter>
                <action android:name="android.support.customtabs.trusted.TRUSTED_WEB_ACTIVITY_SERVICE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <!-- Shows Android's POST_NOTIFICATIONS prompt on the page's behalf.
             When the site calls Notification.requestPermission(), Chrome
             asks the DelegationService above for a PendingIntent to THIS
             activity. The library ships the class but does not declare
             it (androidbrowserhelper 2.5.0's manifest is empty), so
             without this entry the launch fails silently and the page's
             promise never settles: "Turn on notifications" sat on
             "Asking..." forever, and no phone ever subscribed. -->
        <activity
            android:name="com.google.androidbrowserhelper.trusted.NotificationPermissionRequestActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!--
          Runs before any activity, and registers the lifecycle hook
          that pairs the widget on an ordinary app open.

          IT IS A PROVIDER BECAUSE GOOGLE PLAY REWRITES THE APPLICATION
          CLASS. Play's automatic integrity protection replaces
          android:name on <application> with its own
          com.pairip.application.Application and does not delegate to
          the class it displaced, so our Application subclass ran on
          every emulator in CI and on no phone that installed from the
          store. A provider is left alone. See OrbitalStartup.
        -->
        <provider
            android:name=".OrbitalStartup"
            android:authorities="com.orbitalempire.game.startup"
            android:exported="false"
            android:initOrder="100" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.orbitalempire.game.fileprovider"
            android:grantUriPermissions="true"
            android:exported="false">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/filepaths" />
        </provider>
    </application>
</manifest>
