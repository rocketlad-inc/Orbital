<?xml version="1.0" encoding="utf-8"?>
<!-- The status-bar icon for Orbital's notifications: a planet on its
     orbit. Android draws small icons as a white silhouette, so this is
     solid white on transparent with no colour of its own. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- the planet -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M12,7.2a4.8,4.8 0,1 1,0 9.6a4.8,4.8 0,1 1,0 -9.6z" />
    <!-- the orbit, a tilted ring round it -->
    <path
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="1.6"
        android:fillColor="#00000000"
        android:pathData="M2.6,15.4C1.6,13.4 5.6,9.6 11.4,7.3C17.2,5 21.4,5.2 21.4,7.2C22.4,9.2 18.4,13 12.6,15.3C6.8,17.6 3.6,17.4 2.6,15.4z" />
    <!-- a moon on the ring -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M20,4.6a1.5,1.5 0,1 1,0 3a1.5,1.5 0,1 1,0 -3z" />
</vector>
