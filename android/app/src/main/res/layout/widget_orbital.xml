<?xml version="1.0" encoding="utf-8"?>
<!--
  The whole widget. An image, and a line of text for before the image
  exists.

  There is deliberately nothing else here: every pixel of the card is
  drawn by the Worker, because anything laid out in this file could only
  be changed by shipping a new build through store review.

  RemoteViews supports a small, fixed set of view classes, so this uses
  FrameLayout/ImageView/TextView and nothing clever. centerCrop rather
  than fitCenter: the card is rendered for the widget's own dimensions,
  so it should fill them, and letterboxing a correctly-sized image would
  just add black bars.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/orbitalBackground">

    <!-- GONE until a card has been fetched. This file is also the
         widget's initialLayout, which is what the launcher paints the
         instant the widget is dropped, before any code of ours runs at
         all. With the ImageView visible and empty, that first frame was
         a plain black rectangle, and it stayed one for as long as the
         fetch took, or forever if it never ran. A widget that looks
         broken on arrival is indistinguishable from one that is. -->
    <ImageView
        android:id="@+id/widget_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:adjustViewBounds="false"
        android:visibility="gone"
        android:contentDescription="@string/widget_description" />

    <!-- VISIBLE by default, and carrying the hint, so the very first
         frame the launcher draws already tells the player what to do.
         Every later paint sets these two visibilities explicitly. -->
    <TextView
        android:id="@+id/widget_message"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:padding="16dp"
        android:textColor="#8AA0B4"
        android:textSize="13sp"
        android:text="@string/widget_connect_hint" />
</FrameLayout>
