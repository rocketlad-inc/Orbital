<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">Orbital</string>
    <string name="launch_url">https://orbital-empire.com/</string>

    <string name="widget_name">Orbital</string>
    <string name="widget_description">Your system map and what is waiting on you.</string>
    <!-- The widget cannot fetch anything until the game hands it a
         token, and it has no way to ask for one itself. So it says
         exactly where the button is rather than failing quietly. -->
    <!-- Shown from the moment the widget is placed until its pairing
         lands, which is normally a few seconds. -->
    <string name="widget_connecting">Orbital: connecting your widget…</string>
    <string name="widget_connect_hint">Remove and re-add the widget, or: Open Orbital · Menu · Notifications · Send to widget</string>
    <!-- The foreground service that fetches the card must carry a
         notification; this is it, on a silent channel. -->
    <string name="widget_channel">Widget updates</string>
    <string name="widget_updating">Updating your Orbital widget</string>
</resources>
