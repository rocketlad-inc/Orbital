<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      THIS IS WHAT MAKES IT A WATCH APP, and it must not carry
      android:required="false". Play reads this element to decide which
      form factor an artifact is for; marking it optional describes a
      single binary that runs on phones AND watches, which is a
      configuration Play does not support and rejects.
    -->
    <uses-feature android:name="android.hardware.type.watch" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault">

        <!--
          STANDALONE, and the earlier "false" here was a misreading of
          what the flag asks.

          It does NOT ask "can this work with no phone nearby". It asks
          whether the watch app needs the COMPANION PHONE APP for its
          core features, and this one does not. Pairing opens a URL on
          the phone through RemoteActivityHelper; if Orbital is not
          installed there, Chrome handles it and the game's own shell
          binds the code exactly the same way. After that the watch
          talks to orbital-empire.com over its own network and the phone
          is not in the path at all.

          Google validates this value during app serving, and the
          penalty for getting it wrong in EITHER direction is the same:
          the app is hidden from the Play Store on untethered watches.
          A false declaration therefore cost reach and bought nothing.
        -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <uses-library
            android:name="com.google.android.wearable"
            android:required="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:taskAffinity=""
            android:theme="@style/OrbitalWearTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The three screens as tiles. Each fetches with the paired
             token itself and opens its own screen in the app when
             tapped; see Tiles.kt. -->
        <service
            android:name=".EmpireTileService"
            android:exported="true"
            android:label="@string/tile_empire"
            android:description="@string/tile_empire_desc"
            android:icon="@mipmap/ic_launcher"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
            <meta-data
                android:name="androidx.wear.tiles.PREVIEW"
                android:resource="@mipmap/ic_launcher" />
        </service>
        <service
            android:name=".BattlesTileService"
            android:exported="true"
            android:label="@string/tile_battles"
            android:description="@string/tile_battles_desc"
            android:icon="@mipmap/ic_launcher"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
            <meta-data
                android:name="androidx.wear.tiles.PREVIEW"
                android:resource="@mipmap/ic_launcher" />
        </service>
        <service
            android:name=".SenateTileService"
            android:exported="true"
            android:label="@string/tile_senate"
            android:description="@string/tile_senate_desc"
            android:icon="@mipmap/ic_launcher"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
            <meta-data
                android:name="androidx.wear.tiles.PREVIEW"
                android:resource="@mipmap/ic_launcher" />
        </service>
    </application>
</manifest>
