          primaryProviderType="SHORT_TEXT" />
      <BoundingRoundBox x="0" y="0" width="130" height="46" cornerRadius="23" />
      <Complication type="SHORT_TEXT">
        <PartText x="0" y="0" width="130" height="28">
          <Text align="CENTER" ellipsis="TRUE">
            <Font family="audiowide" size="22" color="#ffffca48">
