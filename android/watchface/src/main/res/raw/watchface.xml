              <Template>%s<Parameter expression="[COMPLICATION.TITLE]" /></Template>
            </Font>
          </Text>
        </PartText>
      </Complication>
      <Complication type="RANGED_VALUE">
        <PartDraw x="0" y="0" width="78" height="78">
          <Ellipse x="0" y="0" width="78" height="78">
            <Fill color="#cc0b1119" />
          </Ellipse>
          <Arc centerX="39" centerY="39" width="70" height="70" startAngle="0" endAngle="360">
